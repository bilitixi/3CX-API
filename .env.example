APP_ENV=development
LOG_LEVEL=INFO

# Shared secret required on the `Authorization: Bearer <token>` header of every
# request to this service. Leave blank for local development (auth is skipped).
API_AUTH_TOKEN=

# 3CX Call Control API (ring-with-no-answer-fallback workflow)
THREECX_PBX_BASE_URL=https://your-pbx.3cx.co.nz:5001
THREECX_CLIENT_ID=your-client-id
THREECX_CLIENT_SECRET=your-client-secret
THREECX_GRANT_TYPE=client_credentials
THREECX_TOKEN_SAFETY_MARGIN_SECONDS=60

# Default queue DN for POST /api/threecx/calls/dial-into-queue.
THREECX_QUEUE_DN=8003

# Default source_dn for POST /api/threecx/calls/dial-into-queue, e.g. the internal
# number that should ring first before being connected into the queue.
THREECX_SOURCE_DN=
